{
  "name": "aegis-agents",
  "version": "3.1.0",
  "description": "AEGIS — hardened Counter-REA defense layer (BLA fork): rotation, depth, and measurement fixes",
  "keywords": [
    "reverse-engineering-defense",
    "anti-rea",
    "rea",
    "llm-security",
    "adversarial-defense",
    "obfuscation",
    "algorithmic-tarpit",
    "electron-security",
    "asar",
    "wasm",
    "binary-protection",
    "mcp",
    "coding-agents",
    "claude-code",
    "cursor"
  ],
  "homepage": "https://aegis.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perseusdredd/aegis.git"
  },
  "bugs": {
    "url": "https://github.com/perseusdredd/aegis/issues"
  },
  "license": "MIT",
  "author": "AEGIS Contributors",
  "type": "module",
  "bin": {
    "aegis": "./dist/cli.js",
    "aegis-agents": "./dist/cli.js",
    "aegis-shield": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bundler": {
      "types": "./dist/bundler/index.d.ts",
      "default": "./dist/bundler/index.js"
    }
  },
  "files": [
    "dist",
    ".agents/skills/aegis-counter-rea",
    "README.md",
    "LICENSE",
    "DISCLAIMER.md"
  ],
  "engines": {
    "node": "^22.23.4 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/sync-version.mjs && tsc -p tsconfig.build.json && node -e \"try{require('fs').chmodSync('dist/cli.js',0o755)}catch(e){}\"",
    "dev": "tsx src/cli.ts",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "benchmark": "node dist/cli.js benchmark",
    "version": "node scripts/sync-version.mjs && git add src/identity.ts",
    "sync:site": "node scripts/sync-site.mjs",
    "release:patch": "npm version patch -m 'chore(release): aegis-agents v%s' && git push --follow-tags",
    "release:minor": "npm version minor -m 'chore(release): aegis-agents v%s' && git push --follow-tags",
    "prepublishOnly": "npm test",
    "verify:rea": "node scripts/verify-rea-constants.mjs",
    "redteam:rea": "node scripts/redteam/run.mjs",
    "verify:rea:drift": "node scripts/verify-rea-constants.mjs",
    "crackme:build": "node scripts/crackme/build.mjs",
    "crackme:seal": "node scripts/crackme/seal.mjs && node scripts/crackme/v7-seal.mjs && node scripts/crackme/v8-seal.mjs && node scripts/crackme/v9-seal.mjs",
    "crackme:v6": "node challenge/v6/run.mjs",
    "crackme:v7": "node challenge/v7/run.mjs",
    "crackme:v8:build": "node scripts/crackme/v8-build.mjs",
    "crackme:v8:seal": "node scripts/crackme/v8-seal.mjs",
    "crackme:v8": "node challenge/v8/run.mjs",
    "crackme:v9:build": "node scripts/crackme/v9-build.mjs",
    "crackme:v9:seal": "node scripts/crackme/v9-seal.mjs",
    "crackme:v9": "node challenge/v9/run.mjs"
  },
  "dependencies": {
    "@babel/generator": "^7.26.0",
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
